          "y": 448,
          "fontSize": 36,
          "maxWidth": 1032,
          "fontFamily": "Poppins",
          "color": "#FFFFFF",
          "align": "center",
          "bold": false,
          "editable": true
        },
        {
          "id": "website",
          "type": "text",
          "text": "www.yourbrand.com",
          "x": 600,
          "y": 720,
          "fontSize": 25.6,
          "fontFamily": "Poppins",
          "color": "#FFFFFF",
          "align": "center",
          "bold": false,
          "editable": true
